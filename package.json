{
	"name": "crispy-toast",
	"version": "0.2.0",
	"description": "Native toasts for every platform",
	"keywords": [
		"alert",
		"expo",
		"macos",
		"nextjs",
		"notification",
		"react-native",
		"react-native-web",
		"toast",
		"windows"
	],
	"license": "MIT",
	"author": "BitWebs",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/rudysides/crispy-toast.git"
	},
	"files": [
		"dist",
		"src",
		"!src/**/tests",
		"README.md",
		"LICENSE"
	],
	"type": "module",
	"sideEffects": false,
	"main": "./dist/native/index.js",
	"types": "./dist/native/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/native/index.d.ts",
			"default": "./dist/native/index.js"
		},
		"./web": {
			"types": "./dist/web/index.d.ts",
			"default": "./dist/web/index.js"
		},
		"./package.json": "./package.json"
	},
	"scripts": {
		"build": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\" && tsc",
		"dev": "tsc --watch",
		"typecheck": "tsc --noEmit",
		"lint": "oxlint",
		"format": "oxfmt",
		"format:check": "oxfmt --check",
		"test": "vitest run",
		"prepublishOnly": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test && pnpm build"
	},
	"devDependencies": {
		"@types/node": "^26.6.6",
		"@types/react": "~19.3.0",
		"@types/react-dom": "~19.3.0",
		"oxfmt": "^0.79.0",
		"oxlint": "^1.94.0",
		"react": "19.3.0",
		"react-dom": "19.3.0",
		"react-native": "0.88.1",
		"react-native-safe-area-context": "~5.11.1",
		"typescript": "^7.0.2",
		"vitest": "^5.1.0"
	},
	"peerDependencies": {
		"react": ">=18",
		"react-dom": ">=18",
		"react-native": ">=0.74",
		"react-native-safe-area-context": ">=4"
	},
	"peerDependenciesMeta": {
		"react-dom": {
			"optional": true
		},
		"react-native": {
			"optional": true
		},
		"react-native-safe-area-context": {
			"optional": true
		}
	},
	"devEngines": {
		"packageManager": {
			"name": "pnpm",
			"version": "12.18.0",
			"onFail": "warn"
		}
	},
	"packageManager": "pnpm@12.18.0"
}
